# Where Claude Code runs as "the engine" - this is the directory CLAUDE.md
# and .claude/settings.json (the memory-logging hook) get picked up from.
# Leave unset to default to this local/ folder.
ULTRON_ENGINE_DIR=

# Where the Obsidian vault lives. Leave unset to default to local/memory-vault.
ULTRON_VAULT_DIR=

# How much freedom Claude Code gets to act without asking, since there's no
# one there to click "approve" on a voice-triggered command. See README.md
# for the tradeoffs before changing these.
ULTRON_PERMISSION_MODE=acceptEdits
ULTRON_ALLOWED_TOOLS=Read,Grep,Glob,Edit,Write,WebFetch,WebSearch,TodoWrite

# faster-whisper model size: tiny.en, base.en, small.en, medium.en, large-v3
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# pyttsx3 (default, zero setup) or piper (better voices, needs the piper
# CLI + a downloaded .onnx model - see README.md)
TTS_ENGINE=pyttsx3
PIPER_EXE=piper
PIPER_MODEL=

# HUD server
ULTRON_HUD_PORT=8765

# Remote access (phone over Tailscale, see docs/REMOTE_ACCESS_SETUP.md).
# Leave both unset for local-only use - nothing here changes until you set
# ULTRON_HUD_BIND to something other than 127.0.0.1 AND set a token.
# POST /chat refuses everything unless ULTRON_REMOTE_TOKEN is set and matched,
# no matter what this is bound to.
ULTRON_HUD_BIND=127.0.0.1
ULTRON_REMOTE_TOKEN=
